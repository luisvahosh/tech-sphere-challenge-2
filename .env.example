NVIDIA_API_KEY=

# ELEVENLABS_API_KEY: reservada (no se usa activamente todavia).
# ELEVENLABS_AGENT_ID: agent-id publico para la interfaz de llamada (/llamada).
# ELEVENLABS_WEBHOOK_SECRET: signing secret del webhook post-llamada
#   (dashboard de ElevenLabs > tu agente > Webhooks). Debe coincidir EXACTO
#   con el que se configura ahi, o el endpoint /webhook/post-call responde 401.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# CONSOLE_PASSWORD: clave para entrar a la consola de administracion.
#   Obligatoria en el servidor (la consola queda publica en /consola).
#   Vacia en local = sin clave.
CONSOLE_PASSWORD=

# NPM_NETWORK: red Docker de Nginx Proxy Manager en el servidor
#   (ver `docker network ls`). Solo la usa docker-compose.yml.
NPM_NETWORK=npm_default
